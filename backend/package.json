  "description": "WebAsia Creative Services Platform - Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "migrate": "node src/database/migrate.js",
    "migrate:prod": "NODE_ENV=production node src/database/migrate.js",
    "seed": "node src/database/seed.js",
    "seed:prod": "NODE_ENV=production node src/database/seed.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "saas",
    "creative",
    "subscription",
    "crm"
  ],
  "author": "WebAsia IT Solutions",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.478.0",
    "@aws-sdk/s3-request-presigner": "^3.478.0",
    "@sendgrid/mail": "^8.1.0",
    "archiver": "^7.0.1",
    "aws-sdk": "^2.1515.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.0.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
